# Ignore everything by default
/*

# Keep skill directories
!/business-analyst/
!/content-pipeline/
!/productivity/
!/dev-tools/
!/ai-meta/
!/obsidian/
!/visual-creative/
!/i18n/
!/scripts/

# Keep marketplace.json
!/.claude-plugin/
/.claude-plugin/*
!/.claude-plugin/marketplace.json
# Keep .gitignore itself
!.gitignore

# Keep README and guides
!/README.md
!/README.zh.md
!/README.en.md
!/GEMINI.md
!/CLAUDE.md
!/requirements.txt
!/添加技能指南.md
!/.gitmodules
!/new_lists.md
!/learning-research/


# Keep logo directory
!/_logo/

# Ignore sensitive files in skill directories
**/.env
**/__pycache__/
**/*.pyc
**/node_modules/
**/.claude/
